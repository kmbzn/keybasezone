---
const base = import.meta.env.BASE_URL;
---
<header class="site-header">
  <a class="brand" href={base} aria-label="KeyBaseZone 홈"><img src={`${base}images/kbz.png`} alt="KeyBaseZone" /></a>
  <div class="header-social">
    <a class="header-linkedin" href="https://www.linkedin.com/in/byungjun-kim-327552221/" target="_blank" rel="noreferrer" aria-label="LinkedIn profile"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/linkedin/linkedin-original.svg" alt="" aria-hidden="true" /><span class="header-social-label">LinkedIn</span><span class="header-social-arrow">↗</span></a>
    <a class="header-github" href="https://github.com/kmbzn" target="_blank" rel="noreferrer" aria-label="GitHub profile"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/github/github-original.svg" alt="" aria-hidden="true" /><span class="header-social-label">GitHub</span><span class="header-social-arrow">↗</span></a>
  </div>
</header>
