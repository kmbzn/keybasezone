---
import '../styles/global.css';
import { site } from '../data/site';
const { title = `${site.name} — ${site.slogan}` } = Astro.props;
---
<!doctype html><html lang="ko"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="기술과 디자인, 일상의 경험과 인문학을 기록하고 연결하는 KeyBaseZone의 개인 지식 공간." /><meta name="theme-color" content="#f4f2ec" /><title>{title}</title></head><body><slot /></body></html>
