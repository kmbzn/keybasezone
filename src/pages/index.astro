---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';
import { sidebar } from '../data/sidebar';
import { getContentLastModifiedDate, getContentLastModifiedTimestamp, getContentLastModifiedTimestamps } from '../lib/content-dates.mjs';
import { getArticleCover } from '../lib/article-cover.mjs';
const base = import.meta.env.BASE_URL;
const articleSections = sidebar.filter((section) => section.label);
const lastModifiedTimestamps = getContentLastModifiedTimestamps();
const documents = import.meta.glob('../content/blog-v2/**/*.md', { eager: true });
const getSortTimestamp = (timestamp) => {
  const value = Date.parse(timestamp);
  return Number.isFinite(value) ? value : 0;
};
const featuredStories = articleSections.flatMap((section) => section.entries.map((entry) => {
  const slug = entry.path.replace(/^\//, '');
  const markdownPath = path.join(process.cwd(), 'src/content/blog-v2', `${slug}.md`);
  const markdown = readFileSync(markdownPath, 'utf8');
  const module = documents[`../content/blog-v2/${slug}.md`];
  return {
    category: section.label,
    entry,
    image: getArticleCover(slug, markdown, module?.frontmatter).coverImage,
    updatedAt: getContentLastModifiedDate(lastModifiedTimestamps, slug),
    updatedAtTimestamp: getContentLastModifiedTimestamp(lastModifiedTimestamps, slug),
  };
})).sort((a, b) => getSortTimestamp(b.updatedAtTimestamp) - getSortTimestamp(a.updatedAtTimestamp)).slice(0, 6);
const topics = [
  { n: '01', icon: 'computer', title: 'Computer Science', text: '운영체제, 데이터베이스, 자료 구조와 네트워크. 원리를 이해하고 직접 다뤄 본 배움.', href: `${base}contents/#ubuntu` },
  { n: '02', icon: 'design', title: 'Design', text: '시각 아이덴티티와 타이포그래피부터 제품, 인터페이스까지. 형태와 사용 경험을 살펴봅니다.', href: `${base}contents/#design` },
  { n: '03', icon: 'life', title: 'Technology & Life', text: '기기 활용과 수리, 금융과 소비, 건강과 운동처럼 일상에서 만나는 기술과 선택.', href: `${base}contents/#wellness` },
  { n: '04', icon: 'humanities', title: 'Humanities', text: '역사와 언어, 음악과 사회. 익숙한 경계를 넘어 생각의 맥락을 찾아갑니다.', href: `${base}contents/#humanities` },
];
---
<Layout title="KeyBaseZone">
  <Header />
  <main>
    <section class="hero" id="top">
      <div class="hero-copy">
        <p class="eyebrow">KEYBASEZONE JOURNAL <span>·</span> NOTES ON WHAT MATTERS</p>
        <h1>관심 있는 것들을 공부하고,<br /><em>사용해 보고, 기록합니다.</em></h1>
        <p class="hero-description">기술과 디자인, 일상의 경험과 인문학을 살핍니다. 각 분야의 본질을 찾아 배운 것을 차분히 쌓아가는 공간입니다.</p>
        <div class="hero-actions"><a class="button button-outline" href={`${base}contents/`}>콘텐츠 둘러보기 <span>↗</span></a></div>
      </div>
      <div class="hero-image"><img src={`${base}images/bg.png`} alt="황혼의 궤도 도시" /></div>
      <span class="hero-index">INDEPENDENT KNOWLEDGE JOURNAL <span>—</span> 2026</span>
    </section>

    <section class="journal-section" id="latest">
      <div class="editorial-heading"><div><p class="eyebrow">THE LATEST NOTES</p><h2>최근 기록</h2></div><a href={`${base}contents/`}>전체 글 보기 <span>↗</span></a></div>
      <div class="journal-grid">
        {featuredStories.map((story, index) => (
          <a class:list={["journal-card", `journal-card-${index + 1}`]} href={story.entry.path}>
            <div class="journal-image">
              {story.image ? <img src={story.image} alt="" loading="lazy" /> : <span class="journal-pattern" aria-hidden="true"></span>}
              <span class="journal-category">{story.category}</span>
              <span class="journal-image-arrow" aria-hidden="true">↗</span>
            </div>
            <div class="journal-card-meta"><span>최종 수정 · <time datetime={story.updatedAtTimestamp}>{story.updatedAt.replaceAll('-', '.')}</time></span><span>READ STORY</span></div>
            <h3>{story.entry.title}</h3>
          </a>
        ))}
      </div>
    </section>

    <section class="intro" id="about">
      <div class="intro-visual"><p class="eyebrow">A LITTLE ABOUT ME</p><img src={`${base}images/profile.jpg`} alt="KeyBaseZone 프로필" /></div>
      <div><p>서울에서 컴퓨터 과학을 공부합니다. 기술적 분석에서 출발해 디자인과 생활, 인문학까지, 서로 다른 분야를 오가며 배운 내용을 정리합니다.</p><table class="profile-specs"><tbody><tr><th>Region</th><td>Seoul, South Korea</td></tr><tr><th>GitHub</th><td><a href="https://github.com/kmbzn" target="_blank" rel="noreferrer">github.com/kmbzn ↗</a></td></tr><tr><th>Instagram</th><td><a href="https://instagram.com/kmbzn" target="_blank" rel="noreferrer">@kmbzn ↗</a></td></tr><tr><th>University</th><td>Hanyang Univ. (Class of ’21)</td></tr><tr><th>Major</th><td>Dept. of Computer Science</td></tr><tr><th>High School</th><td>Joongdong High, 112th</td></tr></tbody></table></div>
    </section>

    <section class="topics" id="topics">
      <div class="section-heading"><div><p class="eyebrow">FIELDS OF EXPLORATION</p><h2>탐구하는 분야</h2></div><p>전공에서 생활까지, 궁금한 것을 배우고 정리합니다.</p></div>
      <div class="topic-grid">{topics.map((topic) => (
        <a class:list={['topic', `topic-${topic.icon}`]} href={topic.href}>
          <span class="topic-number">{topic.n}</span>
          <span class="topic-icon" aria-hidden="true">
            <svg viewBox="0 0 96 96" fill="none" xmlns="http://www.w3.org/2000/svg">
              {topic.icon === 'computer' && <>
                <rect x="27" y="27" width="42" height="42" rx="10" />
                <path d="M39 42h8l6 6-6 6h-8m21-12h-3m3 12h-3M48 18v9m-14-6 5 8m-19 5 8 4m-10 11h9m-7 17 9-4m5 16 4-9m20 9-4-9m20-7-9-4m10-12h-9m7-17-9 4m-5-17-4 9" />
                <circle cx="48" cy="48" r="3" fill="currentColor" stroke="none" />
              </>}
              {topic.icon === 'design' && <>
                <circle cx="48" cy="48" r="24" />
                <path d="m48 30 5.2 12.8L66 48l-12.8 5.2L48 66l-5.2-12.8L30 48l12.8-5.2L48 30Z" />
                <circle cx="48" cy="48" r="4" fill="currentColor" stroke="none" />
                <path d="M67 24h6m-3-3v6M23 67h6m-3-3v6" />
              </>}
              {topic.icon === 'life' && <>
                <rect x="31" y="17" width="34" height="62" rx="13" />
                <path d="M42 26h12m-10 40h8m-4-26c-1 8-8 10-8 17 0 5 4 8 8 8s8-3 8-8c0-7-7-9-8-17Z" />
                <path d="M18 35c5 0 8 3 8 8m52 10c-5 0-8 3-8 8" />
              </>}
              {topic.icon === 'humanities' && <>
                <path d="M48 31c-9-8-21-9-31-5v42c10-4 22-3 31 5m0-42c9-8 21-9 31-5v42c-10-4-22-3-31 5m0-42v42" />
                <path d="M25 37c6-2 11-1 16 2m-16 8c6-2 11-1 16 2m14-10c5-3 10-4 16-2m-16 10c5-3 10-4 16-2" />
                <path d="m48 15 2 5 5 2-5 2-2 5-2-5-5-2 5-2 2-5Z" />
              </>}
            </svg>
          </span>
          <div class="topic-copy"><h3>{topic.title}</h3><p>{topic.text}</p></div>
          <span class="topic-mark" aria-hidden="true">↗</span>
        </a>
      ))}</div>
    </section>

    <section class="mindscape-preview">
      <div class="mindscape-art"><img src={`${base}images/android-chrome-512x512.png`} alt="KeyBaseZone 불꽃 아이콘" /></div>
      <div class="mindscape-copy"><p class="eyebrow">THE IDEA BEHIND THE NAME</p><h2>Key<strong>BaseZone</strong></h2><p>본질을 여는 열쇠, 생각을 쌓는 기반, 사유와 창작이 펼쳐지는 영역. 이름에 담긴 세 가지 개념과 이 공간의 방향을 소개합니다.</p><a class="text-link" href={`${base}mindscape/`}>Mindscape 살펴보기 <span>↗</span></a></div>
    </section>

    <section class="contact"><p class="eyebrow">KEEP IN TOUCH</p><h2>생각을 나누고 싶다면</h2><p>질문과 피드백은 언제든 환영합니다.</p><a href="mailto:kmbzn24@gmail.com">kmbzn24@gmail.com <span>↗</span></a></section>
  </main>
  <Footer />
</Layout>
