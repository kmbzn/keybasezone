---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';
import { sidebar } from '../data/sidebar';
import { getContentLastModifiedDate, getContentLastModifiedTimestamp, getContentLastModifiedTimestamps, getContentPublicationTimestamp, getContentPublicationTimestamps } from '../lib/content-dates.mjs';
import { getArticleCover } from '../lib/article-cover.mjs';
import { getArticleTitle } from '../lib/article-title.mjs';
const base = import.meta.env.BASE_URL;
const articleSections = sidebar.filter((section) => section.label);
const lastModifiedTimestamps = getContentLastModifiedTimestamps();
const publicationTimestamps = getContentPublicationTimestamps();
const documents = import.meta.glob('../content/**/*.md', { eager: true });
const getSortTimestamp = (timestamp) => {
  const value = Date.parse(timestamp);
  return Number.isFinite(value) ? value : 0;
};
const featuredStories = articleSections.flatMap((section) => section.entries.map((entry) => {
  const slug = entry.path.replace(/^\//, '');
  const markdownPath = path.join(process.cwd(), 'src/content', `${slug}.md`);
  const markdown = readFileSync(markdownPath, 'utf8');
  const module = documents[`../content/${slug}.md`];
  const cover = getArticleCover(slug, markdown, module?.frontmatter);
  const lastModifiedTimestamp = getContentLastModifiedTimestamp(lastModifiedTimestamps, slug);
  const publicationTimestamp = module?.frontmatter?.published
    ? `${module.frontmatter.published}T00:00:00`
    : getContentPublicationTimestamp(publicationTimestamps, slug);
  return {
    category: section.label,
    entry,
    image: cover.coverImage,
    deck: cover.deck,
    title: getArticleTitle(slug, markdown, module?.frontmatter?.title),
    updatedAt: getContentLastModifiedDate(lastModifiedTimestamps, slug) || publicationTimestamp.slice(0, 10),
    dateLabel: lastModifiedTimestamp ? '최종 수정' : '발행일',
    updatedAtTimestamp: lastModifiedTimestamp || publicationTimestamp,
  };
})).sort((a, b) => getSortTimestamp(b.updatedAtTimestamp) - getSortTimestamp(a.updatedAtTimestamp)).slice(0, 6);
const topics = [
  { n: '01', icon: 'computer', image: `${base}images/topics/computer-science.png`, title: 'Computer Science', text: '운영체제, 데이터베이스, 자료 구조와 네트워크. 원리를 이해하고 직접 다뤄 본 배움.', href: `${base}contents/#ubuntu` },
  { n: '02', icon: 'design', image: `${base}images/topics/design.png`, title: 'Design', text: '시각 아이덴티티와 타이포그래피부터 제품, 인터페이스까지. 형태와 사용 경험을 살펴봅니다.', href: `${base}contents/#design` },
  { n: '03', icon: 'life', image: `${base}images/topics/technology-life.png`, title: 'Technology & Life', text: '기기 활용과 수리, 금융과 소비, 건강과 운동처럼 일상에서 만나는 기술과 선택.', href: `${base}contents/#wellness` },
  { n: '04', icon: 'humanities', image: `${base}images/topics/humanities.png`, title: 'Humanities', text: '역사와 언어, 음악과 사회. 익숙한 경계를 넘어 생각의 맥락을 찾아갑니다.', href: `${base}contents/#humanities` },
];
---
<Layout title="KeyBaseZone">
  <Header />
  <main>
    <section class="hero" id="top">
      <div class="hero-copy">
        <p class="eyebrow">KeyBaseZone journal <span>·</span> Notes on what matters</p>
        <h1>관심 있는 것들을 공부하고,<br /><em><span class="temper-highlight">사용해 보고,</span> 기록합니다.</em></h1>
        <p class="hero-description">기술과 디자인, 일상의 경험과 인문학을 살핍니다. 각 분야의 본질을 찾아 배운 것을 차분히 쌓아가는 공간입니다.</p>
        <div class="hero-actions"><a class="button button-outline" href={`${base}contents/`}>콘텐츠 둘러보기 <span>↗</span></a></div>
      </div>
      <div class="hero-image"><img src={`${base}images/bg.png`} alt="황혼의 궤도 도시" /></div>
      <span class="hero-index">Independent knowledge journal <span>—</span> 2026</span>
    </section>

    <section class="market-glance" aria-label="서울 날씨와 주요 시장 시세">
      <div class="market-glance-viewport">
        <div class="market-glance-track" data-market-track>
          <div class="market-glance-page" data-market-page>
            <div class="market-glance-item"><span>서울 기온</span><strong data-weather-temperature>--</strong></div>
            <div class="market-glance-item"><span>습도</span><strong data-weather-humidity>--</strong></div>
            <div class="market-glance-item"><span>미세먼지 PM2.5</span><strong data-weather-pm25>--</strong></div>
          </div>
          <div class="market-glance-page" data-market-page aria-hidden="true">
            <div class="market-glance-item"><span>Bitcoin · USD</span><strong data-market-value="BITSTAMP:BTCUSD">--</strong><small data-market-change="BITSTAMP:BTCUSD">--</small></div>
            <div class="market-glance-item"><span>KOSPI</span><strong data-market-value="KRX:KOSPI">--</strong><small data-market-change="KRX:KOSPI">--</small></div>
            <div class="market-glance-item"><span>S&amp;P 500</span><strong data-market-value="SP:SPX">--</strong><small data-market-change="SP:SPX">--</small></div>
          </div>
          <div class="market-glance-page" data-market-page aria-hidden="true">
            <div class="market-glance-item"><span>NASDAQ</span><strong data-market-value="NASDAQ:IXIC">--</strong><small data-market-change="NASDAQ:IXIC">--</small></div>
            <div class="market-glance-item"><span>Samsung Electronics</span><strong data-market-value="KRX:005930">--</strong><small data-market-change="KRX:005930">--</small></div>
            <div class="market-glance-item"><span>SK Hynix</span><strong data-market-value="KRX:000660">--</strong><small data-market-change="KRX:000660">--</small></div>
          </div>
        </div>
      </div>
      <p class="market-glance-status" data-market-status role="status" aria-live="polite">실시간 정보 불러오는 중</p>
    </section>

    <section class="journal-section" id="latest">
      <div class="editorial-heading"><div><p class="eyebrow">The latest notes</p><h2>최근 기록</h2></div><a href={`${base}contents/`}>전체 글 보기 <span>↗</span></a></div>
      <div class="journal-grid">
        {featuredStories.map((story, index) => (
          <a class:list={["journal-card", `journal-card-${index + 1}`]} href={story.entry.path}>
            <div class="journal-image">
              {story.image ? <img src={story.image} alt="" loading="lazy" /> : <span class="journal-pattern" aria-hidden="true"></span>}
              <span class="journal-category">{story.category}</span>
              <span class="journal-image-arrow" aria-hidden="true">↗</span>
              <div class="journal-card-overlay">
                <div class="journal-card-meta"><span>{story.dateLabel} · <time datetime={story.updatedAtTimestamp}>{story.updatedAt.replaceAll('-', '.')}</time></span></div>
                <h3>{story.title}</h3>
                <p>{story.deck}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="intro" id="about">
      <div class="intro-visual"><p class="eyebrow">A little about me</p><img src={`${base}images/profile.jpg`} alt="KeyBaseZone 프로필" /></div>
      <div class="intro-details">
        <div class="intro-profile">
          <p>서울에서 컴퓨터 과학을 공부합니다. 기술적 분석에서 출발해 디자인과 생활, 인문학까지, 서로 다른 분야를 오가며 배운 내용을 정리합니다.</p>
          <table class="profile-specs"><tbody><tr><th>Region</th><td>Seoul, South Korea</td></tr><tr><th>GitHub</th><td><a href="https://github.com/kmbzn" target="_blank" rel="noreferrer">github.com/kmbzn ↗</a></td></tr><tr><th>Instagram</th><td><a href="https://instagram.com/kmbzn" target="_blank" rel="noreferrer">@kmbzn ↗</a></td></tr><tr><th>University</th><td>Hanyang Univ. (Class of ’21)</td></tr><tr><th>Major</th><td>Dept. of Computer Science</td></tr><tr><th>High School</th><td>Joongdong High, 112th</td></tr></tbody></table>
        </div>
        <div class="profile-stats">
          <section class="github-contributions" aria-labelledby="github-contributions-title">
            <div class="github-contributions-heading">
              <h2 id="github-contributions-title">GitHub contributions</h2>
              <a href="https://github.com/kmbzn" target="_blank" rel="noreferrer">github.com/kmbzn ↗</a>
            </div>
            <a class="github-contributions-chart" href="https://github.com/kmbzn" target="_blank" rel="noreferrer" aria-label="GitHub contributions graph for kmbzn">
              <img src="https://ghchart.rshah.org/kmbzn" alt="kmbzn GitHub contributions over the past year" loading="lazy" />
            </a>
          </section>
          <section class="solvedac-stats" aria-labelledby="solvedac-stats-title">
            <div class="github-contributions-heading">
              <h2 id="solvedac-stats-title">solved.ac stats</h2>
              <a href="https://solved.ac/profile/kmbzn24" target="_blank" rel="noreferrer">solved.ac/kmbzn24 ↗</a>
            </div>
            <a class="solvedac-stats-card" href="https://solved.ac/profile/kmbzn24" target="_blank" rel="noreferrer" aria-label="solved.ac 통계 카드: kmbzn24">
              <span class="solvedac-stats-image">
                <img src="https://github-readme-solvedac.hyp3rflow.vercel.app/api/?handle=kmbzn24" alt="kmbzn24 solved.ac 티어 및 문제 풀이 통계" loading="lazy" />
                <span class="solvedac-bio-mask" aria-hidden="true"></span>
              </span>
            </a>
          </section>
        </div>
      </div>
    </section>

    <section class="topics" id="topics">
      <div class="section-heading"><div><p class="eyebrow">Fields of exploration</p><h2>탐구하는 분야</h2></div><p>전공에서 생활까지, 궁금한 것을 배우고 정리합니다.</p></div>
      <div class="topic-grid">{topics.map((topic) => (
        <a class:list={['topic', `topic-${topic.icon}`]} href={topic.href}>
          <span class="topic-number">{topic.n}</span>
          <span class="topic-icon" aria-hidden="true">
            <img src={topic.image} alt="" loading="lazy" />
          </span>
          <div class="topic-copy"><h3>{topic.title}</h3><p>{topic.text}</p></div>
          <span class="topic-mark" aria-hidden="true">↗</span>
        </a>
      ))}</div>
    </section>

    <section class="mindscape-preview">
      <div class="mindscape-art"><img src={`${base}images/android-chrome-512x512.png`} alt="KeyBaseZone 불꽃 아이콘" /></div>
      <div class="mindscape-copy"><p class="eyebrow">The idea behind the name</p><h2>Key<strong>BaseZone</strong></h2><p>본질을 여는 열쇠, 생각을 쌓는 기반, 사유와 창작이 펼쳐지는 영역. 이름에 담긴 세 가지 개념과 이 공간의 방향을 소개합니다.</p><a class="text-link" href={`${base}mindscape/`}>Mindscape 살펴보기 <span>↗</span></a></div>
    </section>

    <section class="brand-philosophy" aria-labelledby="brand-philosophy-title">
      <div class="brand-philosophy-intro">
        <p class="eyebrow">KeyBaseZone brand values</p>
        <h2 id="brand-philosophy-title">열정은 뜨겁게,<br /><span>행동은 절제 있게.</span></h2>
        <p>플레임 오렌지와 이를 받쳐주는 템퍼 틸은 열정과 절제를 뜻합니다. 뜨거운 동력과 이를 원하는 방향으로 이끄는 통제력이 함께 KeyBaseZone의 태도를 만듭니다.</p>
      </div>
      <div class="brand-color-list" aria-label="KeyBaseZone 브랜드 컬러">
        <article class="brand-color brand-color-flame">
          <div class="brand-color-copy"><p class="brand-color-hex">#FC5419</p><p class="brand-color-name-ko">플레임 오렌지</p><h3>열정 · 도전 · 추진력</h3><p>목표를 향해 타오르는 에너지. 시작하고, 움직이고, 끝까지 밀어붙이는 힘을 상징합니다.</p><p class="brand-color-name-en">Flame Orange</p></div>
        </article>
        <article class="brand-color brand-color-temper">
          <div class="brand-color-copy"><p class="brand-color-hex">#0BA4A8</p><p class="brand-color-name-ko">템퍼 틸</p><h3>절제 · 균형 · 이성</h3><p>뜨거운 열정을 스스로 다스리는 힘. 냉정함과 안정감, 지속 가능한 성장을 상징합니다.</p><p class="brand-color-name-en">Temper Teal</p></div>
        </article>
      </div>
    </section>

    <section class="contact"><p class="eyebrow">Keep in touch</p><h2>생각을 나누고 싶다면.</h2><p>질문과 피드백은 언제든 환영합니다.</p><a href="mailto:kmbzn24@gmail.com">kmbzn24@gmail.com <span>↗</span></a></section>
  </main>
  <Footer />
</Layout>

<script>
  interface CurrentWeather {
    temperature_2m: number;
    relative_humidity_2m: number;
  }

  interface WeatherResponse {
    current?: CurrentWeather;
  }

  interface AirQualityResponse {
    current?: {
      pm2_5: number;
    };
  }

  interface TradingViewScanResponse {
    data?: Array<{ s: string; d: Array<number | null> }>;
  }

  interface MarketQuote {
    close: number;
    change: number;
  }

  const marketTrack = document.querySelector<HTMLElement>('[data-market-track]');
  const marketPages = marketTrack ? [...marketTrack.querySelectorAll<HTMLElement>('[data-market-page]')] : [];
  const marketStatus = document.querySelector<HTMLElement>('[data-market-status]');

  if (marketTrack && marketPages.length > 0) {
    const showMarketPage = (index: number) => {
      marketTrack.style.transform = `translateY(-${index * marketPages[0].offsetHeight}px)`;
      marketPages.forEach((page, pageIndex) => page.setAttribute('aria-hidden', String(pageIndex !== index)));
    };

    let activePage = 0;
    window.setInterval(() => {
      activePage = (activePage + 1) % marketPages.length;
      showMarketPage(activePage);
    }, 15_000);

    const fetchQuotes = async (region: string, symbols: string[]) => {
      const response = await fetch(`https://scanner.tradingview.com/${region}/scan`, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain' },
        body: JSON.stringify({ symbols: { tickers: symbols }, columns: ['close', 'change'] }),
      });
      if (!response.ok) throw new Error(`TradingView ${region} scanner responded with HTTP ${response.status}`);
      const payload = await response.json() as TradingViewScanResponse;
      const quotes = new Map<string, MarketQuote>();
      for (const row of payload.data ?? []) {
        const [close, change] = row.d;
        if (typeof close === 'number' && Number.isFinite(close) && typeof change === 'number' && Number.isFinite(change)) {
          quotes.set(row.s, { close, change });
        }
      }
      for (const symbol of symbols) {
        if (!quotes.has(symbol)) throw new Error(`TradingView returned no current quote for ${symbol}`);
      }
      return quotes;
    };

    const formatQuote = (symbol: string, value: number) => {
      if (symbol === 'BITSTAMP:BTCUSD') return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(value);
      if (symbol === 'KRX:005930' || symbol === 'KRX:000660') return `₩${new Intl.NumberFormat('ko-KR', { maximumFractionDigits: 0 }).format(value)}`;
      return new Intl.NumberFormat('en-US', { maximumFractionDigits: 2 }).format(value);
    };

    const formatChange = (change: number) => `${change > 0 ? '+' : ''}${change.toFixed(2)}%`;

    const updateMarketQuotes = async () => {
      try {
        const [crypto, korea, america] = await Promise.all([
          fetchQuotes('crypto', ['BITSTAMP:BTCUSD']),
          fetchQuotes('korea', ['KRX:KOSPI', 'KRX:005930', 'KRX:000660']),
          fetchQuotes('america', ['SP:SPX', 'NASDAQ:IXIC']),
        ]);
        const quotes = new Map([...crypto, ...korea, ...america]);
        marketTrack.querySelectorAll<HTMLElement>('[data-market-value]').forEach((element) => {
          const symbol = element.dataset.marketValue;
          const quote = symbol ? quotes.get(symbol) : undefined;
          if (symbol && quote) element.textContent = formatQuote(symbol, quote.close);
        });
        marketTrack.querySelectorAll<HTMLElement>('[data-market-change]').forEach((element) => {
          const symbol = element.dataset.marketChange;
          const quote = symbol ? quotes.get(symbol) : undefined;
          if (symbol && quote) {
            element.textContent = formatChange(quote.change);
            element.classList.toggle('market-change-up', quote.change > 0);
            element.classList.toggle('market-change-down', quote.change < 0);
            element.classList.toggle('market-change-flat', quote.change === 0);
          }
        });
        if (marketStatus && ['실시간 정보 불러오는 중', '시세 정보를 불러오지 못했습니다'].includes(marketStatus.textContent ?? '')) {
          marketStatus.textContent = '';
        }
      } catch (error) {
        console.error('Unable to load market quotes:', error);
        if (marketStatus) marketStatus.textContent = '시세 정보를 불러오지 못했습니다';
      }
    };

    const updateWeather = async () => {
      try {
        const [weatherResponse, airQualityResponse] = await Promise.all([
          fetch('https://api.open-meteo.com/v1/forecast?latitude=37.5665&longitude=126.9780&current=temperature_2m,relative_humidity_2m&timezone=Asia%2FSeoul'),
          fetch('https://air-quality-api.open-meteo.com/v1/air-quality?latitude=37.5665&longitude=126.9780&current=pm2_5&timezone=Asia%2FSeoul'),
        ]);
        if (!weatherResponse.ok || !airQualityResponse.ok) {
          throw new Error(`Open-Meteo responded with HTTP ${weatherResponse.status}/${airQualityResponse.status}`);
        }

        const [weather, airQuality] = await Promise.all([
          weatherResponse.json() as Promise<WeatherResponse>,
          airQualityResponse.json() as Promise<AirQualityResponse>,
        ]);
        const current = weather.current;
        const particulateMatter = airQuality.current?.pm2_5;
        if (!current || !Number.isFinite(current.temperature_2m) || !Number.isFinite(current.relative_humidity_2m) || !Number.isFinite(particulateMatter)) {
          throw new Error('Open-Meteo returned incomplete current conditions');
        }

        const setValue = (selector: string, value: string) => {
          const element = marketTrack?.querySelector<HTMLElement>(selector);
          if (element) element.textContent = value;
        };
        setValue('[data-weather-temperature]', `${Math.round(current.temperature_2m)}°`);
        setValue('[data-weather-humidity]', `${Math.round(current.relative_humidity_2m)}%`);
        setValue('[data-weather-pm25]', `${Math.round(particulateMatter)} µg/m³`);
        if (marketStatus && ['실시간 정보 불러오는 중', '날씨 정보를 불러오지 못했습니다'].includes(marketStatus.textContent ?? '')) {
          marketStatus.textContent = '';
        }
      } catch (error) {
        console.error('Unable to load Seoul weather and air quality:', error);
        if (marketStatus) marketStatus.textContent = '날씨 정보를 불러오지 못했습니다';
      }
    };

    void updateMarketQuotes();
    void updateWeather();
    window.setInterval(() => void updateMarketQuotes(), 60_000);
    window.setInterval(() => void updateWeather(), 10 * 60_000);
  }
</script>
