---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { sidebar } from '../data/sidebar';

const sections = sidebar.filter((section) => section.label);
---
<Layout title="Contents | KeyBaseZone">
  <Header />
  <main class="contents-page">
    <section class="contents-hero" style={`--contents-background:url("${import.meta.env.BASE_URL}images/earth-dawn-from-space.png")`}>
      <div class="contents-hero-copy"><h1>Contents</h1></div>
    </section>
    <section class="contents-grid" aria-label="콘텐츠 카테고리">
      {sections.map((section, index) => (
        <article class="content-category" id={section.label?.toLowerCase()} style={`--category-index:${index}`}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h2>{section.label}</h2>
          <ul>
            {section.entries.map((entry) => <li><a href={entry.path}>{entry.title}<b>↗</b></a></li>)}
          </ul>
        </article>
      ))}
    </section>
  </main>
  <Footer />
</Layout>
