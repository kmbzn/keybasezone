---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { sidebar } from '../data/sidebar';

const sections = sidebar.filter((section) => section.label);
---
<Layout title="Contents | KeyBaseZone">
  <Header />
  <main class="contents-page">
    <section class="contents-hero" style={`--contents-background:url("${import.meta.env.BASE_URL}images/earth-orbit-global-network.png")`}>
      <div class="contents-hero-copy">
        <p class="eyebrow">The KeyBaseZone archive <span>·</span> {String(sections.length).padStart(2, '0')} categories</p>
        <h1>Contents</h1>
        <p class="contents-hero-description">전공 기술부터 생활의 발견까지, 배우고 기록한 이야기들.</p>
        <nav class="contents-jump" aria-label="카테고리 바로가기">{sections.map((section) => <a href={`#${section.label?.toLowerCase()}`}>{section.label}</a>)}</nav>
      </div>
    </section>
    <section class="contents-grid" aria-label="콘텐츠 카테고리">
      {sections.map((section, index) => (
        <article class="content-category" id={section.label?.toLowerCase()} style={`--category-index:${index}`}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h2>{section.label}</h2>
          <ul>
            {section.entries.map((entry) => <li><a href={entry.path}>{entry.title}<b>↗</b></a></li>)}
          </ul>
        </article>
      ))}
    </section>
  </main>
  <Footer />
</Layout>
