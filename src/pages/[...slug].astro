---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';
import { getArticleCover } from '../lib/article-cover.mjs';
import { getContentLastModifiedDate, getContentLastModifiedDates } from '../lib/content-dates.mjs';

export function getStaticPaths() {
  const documents = import.meta.glob('../content/blog-v2/**/*.md', { eager: true });
  const lastModifiedDates = getContentLastModifiedDates();
  return Object.entries(documents)
    .filter(([filePath]) => !filePath.endsWith('/README.md'))
    .map(([filePath, module]) => {
      const slug = filePath.split('/content/blog-v2/')[1].replace(/\.md$/, '');
      const markdown = readFileSync(path.join(process.cwd(), 'src/content/blog-v2', slug + '.md'), 'utf8');
      const title = module.frontmatter?.title || markdown.match(/^#\s+(.+?)\s*#*\s*$/m)?.[1] || slug.split('/').at(-1)?.replaceAll('-', ' ') || 'KeyBaseZone';
      return { params: { slug }, props: { Content: module.default, title, updatedAt: getContentLastModifiedDate(lastModifiedDates, slug), ...getArticleCover(slug, markdown, module.frontmatter) } };
    });
}

const { Content, title, category, coverHue, coverPattern, coverImage, deck, updatedAt } = Astro.props;
---
<Layout title={title + ' — KeyBaseZone'}>
  <Header />
  <header class:list={['article-cover', 'article-pattern-' + coverPattern]} style={'--cover-hue:' + coverHue}>
    <div class:list={['article-cover-visual', coverImage ? 'has-image' : 'pattern-only']}>
      {coverImage && <img src={coverImage} alt="" fetchpriority="high" />}
      <div class="article-cover-pattern" aria-hidden="true"></div>
      <span class="article-cover-visual-mark">KEYBASEZONE JOURNAL</span>
    </div>
    <div class="article-cover-copy">
      <p class="article-cover-kicker">{category} <span>·</span> FIELD NOTES</p>
      <h1>{title}</h1>
      {deck && <p class="article-cover-deck">{deck}</p>}
      <p class="article-cover-updated">최종 수정 · {updatedAt.replaceAll('-', '.')}</p>
      <p class="article-cover-byline">A PERSONAL KNOWLEDGE ARCHIVE</p>
      <a class="article-cover-back" href="/contents/">ALL STORIES <span>↗</span></a>
    </div>
  </header>
  <section class="article-reading">
    <div class="docs-layout">
      <Sidebar />
      <main class="markdown-content"><Content /></main>
    </div>
  </section>
  <Footer />
</Layout>
