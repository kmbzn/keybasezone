---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';

const documents = import.meta.glob('../content/blog-v2/**/*.md', { eager: true });

export function getStaticPaths() {
  return Object.entries(documents)
    .filter(([path]) => !path.endsWith('/README.md'))
    .map(([path, module]) => {
      const slug = path.split('/content/blog-v2/')[1].replace(/\.md$/, '');
      const title = module.frontmatter?.title || slug.split('/').at(-1)?.replaceAll('-', ' ') || 'KeyBaseZone';
      return { params: { slug }, props: { Content: module.default, title } };
    });
}

const { Content, title } = Astro.props;
---
<Layout title={`${title} — KeyBaseZone`}>
  <Header />
  <div class="docs-layout">
    <Sidebar />
    <main class="markdown-content"><Content /></main>
  </div>
  <Footer />
</Layout>
