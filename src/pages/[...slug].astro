---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';
import { getArticleCover } from '../lib/article-cover.mjs';
import { getContentLastModifiedDate, getContentLastModifiedTimestamps, getContentPublicationDate, getContentPublicationDates } from '../lib/content-dates.mjs';

export function getStaticPaths() {
  const documents = import.meta.glob('../content/**/*.md', { eager: true });
  const lastModifiedTimestamps = getContentLastModifiedTimestamps();
  const publicationDates = getContentPublicationDates();
  return Object.entries(documents)
    .filter(([filePath]) => !filePath.endsWith('/README.md'))
    .map(([filePath, module]) => {
      const slug = filePath.split('/content/')[1].replace(/\.md$/, '');
      const markdown = readFileSync(path.join(process.cwd(), 'src/content', slug + '.md'), 'utf8');
      const title = module.frontmatter?.title || markdown.match(/^#\s+(.+?)\s*#*\s*$/m)?.[1] || slug.split('/').at(-1)?.replaceAll('-', ' ') || 'KeyBaseZone';
      return { params: { slug }, props: { Content: module.default, title, publishedAt: module.frontmatter?.published || getContentPublicationDate(publicationDates, slug), updatedAt: getContentLastModifiedDate(lastModifiedTimestamps, slug), ...getArticleCover(slug, markdown, module.frontmatter) } };
    });
}

const { Content, title, category, coverHue, coverPattern, coverImage, deck, publishedAt, updatedAt } = Astro.props;
---
<Layout title={title + ' — KeyBaseZone'} description={deck || title} ogTitle={title} ogDescription="KeyBaseZone" ogImage={coverImage || '/images/bg.png'}>
  <Header />
  <header class:list={['article-cover', 'article-pattern-' + coverPattern]} style={'--cover-hue:' + coverHue}>
    <div class:list={['article-cover-visual', coverImage ? 'has-image' : 'pattern-only']}>
      {coverImage && <img src={coverImage} alt="" fetchpriority="high" />}
      <div class="article-cover-pattern" aria-hidden="true"></div>
      <span class="article-cover-visual-mark">KeyBaseZone journal</span>
    </div>
    <div class="article-cover-copy">
      <p class="article-cover-kicker">{category} <span>·</span> Field notes</p>
      <h1>{title}</h1>
      {deck && <p class="article-cover-deck">{deck}</p>}
      <p class="article-cover-updated">발행일 · {publishedAt.replaceAll('-', '.')} <span>·</span> 최종 수정 · {updatedAt.replaceAll('-', '.')}</p>
      <p class="article-cover-byline">A personal knowledge archive</p>
      <div class="article-cover-actions">
        <button class="article-cover-copy-url" type="button" data-copy-article-url>URL 복사</button>
        <span class="article-cover-copy-status" data-copy-article-url-status role="status" aria-live="polite"></span>
        <a class="article-cover-back" href="/contents/">All stories <span>↗</span></a>
      </div>
    </div>
  </header>
  <section class="article-reading">
    <div class="docs-layout">
      <Sidebar />
      <main class="markdown-content"><Content /></main>
    </div>
  </section>
  <Footer />
</Layout>

<script>
  const copyUrlButton = document.querySelector<HTMLButtonElement>('[data-copy-article-url]');
  const copyUrlStatus = document.querySelector<HTMLElement>('[data-copy-article-url-status]');

  copyUrlButton?.addEventListener('click', async () => {
    try {
      if (!navigator.clipboard?.writeText) throw new Error('Clipboard API is unavailable');
      await navigator.clipboard.writeText(window.location.href);
      if (copyUrlStatus) copyUrlStatus.textContent = '주소를 복사했습니다.';
    } catch (error) {
      console.error('Failed to copy article URL:', error);
      if (copyUrlStatus) copyUrlStatus.textContent = '주소 복사에 실패했습니다. 브라우저 권한을 확인해 주세요.';
    }
  });
</script>
